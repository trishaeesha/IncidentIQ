{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"IncidentIQ Researcher-Validated Case Set Record",
  "type":"object",
  "required":["case_id","condition","condition_rationale","validation_status","system","fault_type","repeat_group","evidence_refs"],
  "properties":{
    "case_id":{"type":"string","minLength":1},
    "condition":{"enum":["clear","ambiguous","conflicting","incomplete","misleading","novel"]},
    "condition_rationale":{"type":"string","minLength":1},
    "candidate_hypotheses":{"type":"array","items":{"type":"string"}},
    "evidence_characteristics":{"type":"array","items":{"type":"string"}},
    "required_evidence":{"type":"array","items":{"type":"string"}},
    "missing_evidence":{"type":"array","items":{"type":"string"}},
    "conflicting_sources":{"type":"array","items":{"type":"string"}},
    "misleading_signals":{"type":"array","items":{"type":"string"}},
    "historical_match_quality":{"type":["string","null"]},
    "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "validation_status":{"enum":["VALIDATED","UNVALIDATED"]},
    "system":{"type":"string","minLength":1},
    "fault_type":{"type":"string","minLength":1},
    "modality":{"type":"array","items":{"enum":["metrics","logs","traces"]}},
    "repeat_group":{"type":"string","minLength":1},
    "service_key":{"type":["string","null"]}
  },
  "additionalProperties":false
}